# ═══════════════════════════════════════════════════════════════
# 加密货币投研系统 - 环境变量模板
# 使用方法：cp .env.example .env → 编辑 .env 填入真实值
# 所有生产密钥不要提交到 Git！.env 已在 .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL（自建，postgresql 容器内部通信）──────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=crypto
# Zeabur 旧连接串（迁移时用 pg_restore 从这里导出）
ZEABUR_DATABASE_URL=postgresql://user:pass@host.zeabur.app:port/dbname

# ─── 端口（内部固定 9999，Zeabur 自动注入的 PORT 在这里覆盖）────────
PORT=9999
GUNICORN_WORKERS=2

# ─── 调度器 ─────────────────────────────────────────────────────
SCHEDULER_ENABLED=
SCHEDULER_TIMEZONE=Asia/Shanghai

# ─── SMTP 邮件告警（复用 Zeabur 的 SMTP 配置即可）─────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=
SMTP_FROM=
ADMIN_EMAIL=

# ─── 实盘交易（⚠️ 敏感密钥，轮换后填入）──────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
SIGNAL_TRADE_ENABLED=0

# ─── 数据源 API Key ─────────────────────────────────────────────
COINGECKO_API_KEY=
COINGLASS_API_KEY=
DEEPSEEK_API_KEY=
CMC_PRO_API_KEY=
ETHERSCAN_API_KEY=
FIRECRAWL_API_KEY=

# ─── 其他（按需补充，从 Zeabur 环境变量抄过来）───────────────────
# 你在 Zeabur 环境变量里看到的所有 key，都在这下面追加
# 格式：KEY=value
