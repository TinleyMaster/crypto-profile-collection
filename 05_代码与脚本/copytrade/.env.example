# COPYTRADE-AUTO-001 配置模板（全占位符，无真实凭证）
# 复制为 .env 后自行填写；.env 已被 .gitignore 忽略，程序不输出密钥。

# === 目标交易员 ===
CT_LEADER_UID=5075281354358777856

# === 运行模式 ===
# paper = 只生成信号/记录，不下单（默认，安全）
# live  = 真实下单，必须同时填 CT_API_KEY / CT_API_SECRET
CT_MODE=paper
CT_API_KEY=
CT_API_SECRET=

# === 资金映射（D4 由用户拍板）===
CT_ALLOCATED_CAPITAL=1000

# === 数据源 ===
# 首选代理；程序会禁用环境代理继承（env 里的死代理会导致 502）
CT_PROXY=http://127.0.0.1:7890
# 代理候选池（逗号分隔），单代理间歇 502 时按序轮换；填 direct 可加入直连兜底
CT_PROXY_CANDIDATES=http://127.0.0.1:7890
# 每轮拉取最新页条数；冷启动全量回填最大页数（防无限翻页）
CT_PAGE_SIZE=100
CT_BOOTSTRAP_MAX_PAGES=20
CT_POLL_INTERVAL=15
CT_BACKOFF_SEC=2,4,6,8,16
CT_SOURCE_FAIL_TH=3
CT_SOURCE_STALE_SEC=180

# === 风控闸门 ===
CT_MAX_SINGLE_RATIO=0.10
CT_MAX_TOTAL_RATIO=0.60
CT_MAX_SYMBOL_RATIO=0.30
CT_MAX_LEVERAGE=3.0
CT_RECON_TOLERANCE=0.05
CT_LEADER_IDLE_H=24

# === 数据库 ===
# 留空 = 本地 SQLite（copytrade/data/copytrade.sqlite），不连 prod
# 如需自建 Postgres，填完整 DSN（切勿填生产库凭证）
CT_DATABASE_URL=

# === 离线回放（无网络验证状态机）===
CT_REPLAY_MODE=false
CT_REPLAY_DIR=fixtures
