# ── 数据库 ──
DATABASE_URL=postgresql://username:password@host:port/database

# ── 文档存储 ──
# 白皮书、审计报告等文档文件的本地存储根目录（绝对路径）
# storage_path 为相对路径，会拼接此根目录定位文件
# Workbench 提供 /api/docs/<相对路径> 路由访问这些文件
DOCS_STORAGE_ROOT=/path/to/docs_storage

# ── 数据源 API Key ──
CMC_API_KEY=your_cmc_api_key
COINGECKO_API_KEY=your_coingecko_api_key          # 多个 key 用英文逗号分隔
GITHUB_TOKEN=your_github_token
BINPLORER_API_KEY=freekey
ETHERSCAN_API_KEY=your_etherscan_api_key           # 链上持仓快照 / 大额转账
BSCSCAN_API_KEY=your_bscscan_api_key               # BSC 链上数据
CRYPTOETF_KEY=your_cryptoetf_key                   # cryptoetf.today ETF 净流入 + CEFI 指数
FRED_API_KEY=your_fred_api_key                     # 美联储经济数据（DXY/美十债等）

# ── LLM（OpenAI 兼容，二选一或都配）──
# DeepSeek / 通用 OpenAI 兼容
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 豆包 / 火山方舟
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro-32k

# ── 邮件通知（解锁追踪 / 空头提醒 / 调度失败告警）──
SMTP_HOST=smtp.example.com
SMTP_PORT=465                                      # 465=SSL, 587=STARTTLS
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password
SMTP_TO=recipient@example.com                      # 多个收件人用英文逗号分隔
SMTP_FROM=your_email@example.com                   # 可选，默认等于 SMTP_USER
ADMIN_EMAIL=admin@example.com                      # 系统维护告警专用收件人（仅发管理员）

# ── KOL 信号自动交易（币胜操盘手日记 → 币安子账户）──
# IMAP 收信：默认复用 SMTP_USER / SMTP_PASS（QQ 邮箱一个授权码通用于 SMTP/IMAP）
IMAP_HOST=imap.qq.com
IMAP_PORT=993
# IMAP_USER=                                   # 可选，默认等于 SMTP_USER
# IMAP_PASS=                                   # 可选，默认等于 SMTP_PASS
# 币安子账户合约 API Key：只开「合约交易」权限，绝不开提现权限
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_FAPI_BASE_URL=https://fapi.binance.com
# 总开关：=1 时配合 --live 参数才真正下单（双保险）
SIGNAL_TRADE_ENABLED=0
SIGNAL_MAX_NOTIONAL_USDT=300                    # 单笔最大名义价值（USDT）
SIGNAL_LEVERAGE=5                               # 开仓杠杆
SIGNAL_ORDER_TYPE=limit                         # limit=挂单进场价 / market=市价
SIGNAL_MAX_PRICE_DEVIATION_PCT=1.5              # 现价偏离进场价超过该比例则跳过（%）
SIGNAL_COOLDOWN_MINUTES=30                      # 同一币种两次开单最小间隔（分钟）
SIGNAL_STOP_LOSS_PCT=0                          # 固定止损比例（0=不设；仅 AI 关闭时生效）
SIGNAL_TAKE_PROFIT_PCT=0                        # 固定止盈比例（0=不设；仅 AI 关闭时生效）
# AI 止损止盈：AI 结合信号+市场给建议，2% 总资金硬顶 clamp，AI 失败用兜底（绝不裸奔）
SIGNAL_AI_SLTP_ENABLED=1                        # =1 启用 AI 止损止盈（需已配 OPENAI/ARK Key）
SIGNAL_MAX_LOSS_PCT_OF_EQUITY=2                 # 单笔最大亏损占总权益的百分比（硬顶）
SIGNAL_FALLBACK_STOP_LOSS_PCT=1.5               # AI 失败时的兜底止损距离（%）
SIGNAL_ATR_MULTIPLIER=2                         # 止损机械底线 = ATR 倍数 × ATR%（防噪音扫损）
# DB 驱动：只处理 AI 分类确认的实时喊单（post_type='prediction'）
SIGNAL_KOL_WHITELIST=首席操盘手日记                # 允许自动开单的 KOL 昵称白名单（逗号分隔，空=全部 kol 类博主）
SIGNAL_MIN_CONFIDENCE=0.8                       # 信号最低置信度（AI 分类，默认 0.8）
SIGNAL_MAX_AGE_HOURS=6                          # 只处理发帖后 N 小时内的信号（防陈旧单）

# ── 调度器（scheduler.py，仅调度服务需要）──
SERVICE_ROLE=scheduler                             # web / scheduler；web 是默认值
SCHEDULER_TIMEZONE=Asia/Shanghai                   # 调度时区，默认 Asia/Shanghai
SCHEDULER_ENABLED=                                 # 逗号分隔的任务 key 白名单，空=全部启用
SCHEDULER_LOG_DIR=                                 # 日志目录，默认 /app/task_state/scheduler

# ── 监控阈值（可选，有默认值）──
TREND_DROP_PCT=15                                  # 空头趋势跌幅阈值（%），默认 15
UNLOCK_ALERT_DAYS=14                               # 解锁提前提醒天数（默认 14，分赛道会覆盖）
WHALE_TRANSFER_MIN_USD=100000                      # Meme 大户转账告警阈值（美元）
